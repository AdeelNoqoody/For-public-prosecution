# Self-Service Kiosk — device settings.
# Copy this file to `kiosk.env` in the same folder as "Self-Service Kiosk.exe", edit, and
# restart the app. Every line is optional; the values shown are the defaults.

# ─── Window ───────────────────────────────────────────────────────
# window = normal window (minimize / maximize / close) — for demos on a PC
# kiosk  = locked fullscreen for the real kiosk device: no close button, Alt+F4 blocked,
#          starts with Windows. Operator exit: Ctrl+Shift+Alt+Q
KIOSK_WINDOW_MODE=window

KIOSK_ID=KIOSK-001
IDLE_TIMEOUT_SECONDS=60

# ─── Payments ─────────────────────────────────────────────────────
# Maximum amount per payment in dirhams (100 = 1.00 QAR). 0 = no limit.
MAX_PAYMENT_AMOUNT_MINOR=100
PAYMENT_TIMEOUT_SECONDS=120

# mock = built-in simulated POS (no real card terminal)
# real = live POS machine (requires the vendor integration + the settings below)
POS_PROVIDER=mock
# POS_BASE_URL=
# POS_API_KEY=
# POS_TERMINAL_ID=
# POS_WEBHOOK_SECRET=
# Public address of this PC for POS result webhooks (e.g. a Cloudflare Tunnel URL):
# PUBLIC_URL=

# Built-in mock POS behaviour: auto | approve | decline | error | timeout | manual
# Its control page is at http://localhost:4900 while the app is running.
MOCK_POS_OUTCOME=auto
MOCK_POS_DELAY_MS=5000

# ─── Advanced ─────────────────────────────────────────────────────
# Local ports of the built-in service and mock POS.
# SERVER_PORT=4800
# MOCK_POS_PORT=4900
# Use an external server instead of the built-in one:
# KIOSK_EMBEDDED=false
# KIOSK_SERVER_URL=http://server-address:4000
