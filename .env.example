# ─── POS provider ────────────────────────────────────────────────
# mock = talk to apps/mock-pos (generic adapter) | real = Noqoody SmartECR (RealPosProvider)
POS_PROVIDER=mock
# mock: http://localhost:4100 | real: https://smartecr-api.noqoody.qa
POS_BASE_URL=http://localhost:4100
# Noqoody: X-Merchant-Key (apiKey). mock: any value.
POS_API_KEY=dev-pos-api-key
# Noqoody only: merchant id and the AES-256 encryption key (leave blank for mock).
POS_MERCHANT_ID=
POS_ENCRYPTION_KEY=
# Noqoody: the POS device to charge (posDeviceId). mock: any terminal id.
POS_TERMINAL_ID=TERM-0001
# Webhook secret. mock: HMAC-SHA256(rawBody), header X-Signature.
#                real (Noqoody): HMAC-SHA256(`${timestamp}.${rawBody}`), header X-Webhook-Signature.
POS_WEBHOOK_SECRET=change-me-dev-webhook-secret
# Max age (seconds) of a webhook timestamp before it is rejected as a replay
POS_WEBHOOK_TOLERANCE_SECONDS=300

# ─── Backend server ──────────────────────────────────────────────
SERVER_PORT=4000
# Public base URL of THIS server as reachable by the POS provider (ngrok / Cloudflare Tunnel URL for real POS testing)
PUBLIC_URL=http://localhost:4000
# mock = fixtures in apps/server/src/mock/fixtures | real = RealDataProvider (stub)
DATA_PROVIDER=mock
# SQLite file (relative to apps/server)
DATABASE_PATH=./data/kiosk.db
PAYMENT_TIMEOUT_SECONDS=120
# Hard cap per payment in minor units (100 = 1.00 QAR). Anything above is rejected before reaching the POS. 0 = no limit.
MAX_PAYMENT_AMOUNT_MINOR=100
LOG_LEVEL=info

# ─── Kiosk app ───────────────────────────────────────────────────
KIOSK_ID=KIOSK-001
KIOSK_SERVER_URL=http://localhost:4000
IDLE_TIMEOUT_SECONDS=60
# Force kiosk (fullscreen, locked) mode in development. Always on in packaged builds.
KIOSK_MODE=false

# ─── Mock POS (apps/mock-pos) ────────────────────────────────────
MOCK_POS_PORT=4100
# Delay before the mock terminal "completes" a transaction and sends the webhook
MOCK_POS_DELAY_MS=5000
# auto = decide by amount (see README) | approve | decline | error | timeout | manual (use the control page)
MOCK_POS_OUTCOME=auto
