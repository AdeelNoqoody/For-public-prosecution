<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS hosting via HttpPlatformHandler: IIS itself starts and restarts Node — no ARR, no PM2,
  no separate port. Requires the "HttpPlatformHandler" IIS module (one-time install).

  If node.exe is not in C:\Program Files\nodejs\, change processPath below.
  Logs (startup errors) are written to .\logs\ — give the site's App Pool identity write access.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="%ProgramFiles%\nodejs\node.exe"
                  arguments="webhook-receiver.mjs"
                  startupTimeLimit="20"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment="webhook-results.json" />
          <add segment="logs" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
