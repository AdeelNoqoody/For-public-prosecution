# Copy to .env (git-ignored) or set these as environment variables on your host.
# These MUST match the Noqoody merchant whose payments this receiver handles.

# Webhook HMAC secret (Noqoody webhookSecret) — used to verify X-Webhook-Signature.
WEBHOOK_SECRET=

# AES-256 encryption key (Noqoody encryptionKey) — used to decrypt the webhook encryptedData.
ENCRYPTION_KEY=

# Port this service listens on (your host may set this for you).
PORT=8080

# Where to keep the results DB (its own file — NOT the kiosk's database).
DB_PATH=./webhook-results.db
